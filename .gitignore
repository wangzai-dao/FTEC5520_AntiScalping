# ---- Private keys and local chain data: never commit ----
.env
blockchain/data/
blockchain/geth.log
blockchain/geth.pid
blockchain/miner.key
blockchain/miner.addr
blockchain/password.txt

# ---- Regenerable tooling and dependencies ----
.venv/
tools/*
!tools/.gitkeep
contracts/bin/
contracts/lib/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# ---- Office lock files (LibreOffice/PowerPoint leave these behind) ----
*/.~*.pptx
*/.~*.docx
.~*.pptx

# ---- Runtime artefacts ----
results/*.log

# ---- Local caches ----
.mplconfig/
